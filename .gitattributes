# Unity's YAML serialization writes "key: " with a trailing space for empty values and rewrites these files
# itself, so whitespace checks would flag every regeneration.
*.asset -whitespace
*.mat -whitespace
*.meta -whitespace
*.unity -whitespace
*.prefab -whitespace
*.controller -whitespace
*.mask -whitespace
# TextMeshPro's essential resources are vendored from Unity's UI package unchanged.
unity/Assets/TextMesh[[:space:]]Pro/** -whitespace
# Meshes generated by Sankofa > Build Hearth Scene: large serialized vertex data that is never reviewed by diff.
unity/Assets/Sankofa/Art/Generated/Meshes/*.asset -diff
# Licence texts are kept exactly as their authors published them.
**/OFL.txt -whitespace
**/UAL-License.txt -whitespace
