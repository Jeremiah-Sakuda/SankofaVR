{
  "schema": 1,
  "id": "placeholder.carried-ember",
  "version": "0.1.0",
  "title": "The Carried Ember (development placeholder)",
  "locale": "en",
  "status": "placeholder",
  "note": "Exercises the hearth, one receive invitation with a passive default, a stationary entry, a later reveal and the return. Not a selected episode. It makes no historical or cultural claims and is not reviewed content.",
  "scenes": [
    { "id": "hearth", "kind": "hearth" },
    { "id": "story.yard", "kind": "story" }
  ],
  "objects": [
    { "id": "ember", "scene": "hearth", "capabilities": ["offer", "place"] },
    { "id": "lantern", "scene": "story.yard", "capabilities": ["reveal", "illuminate"], "continues": "ember" },
    { "id": "bowl", "scene": "story.yard", "capabilities": ["reveal", "illuminate"] }
  ],
  "claims": [],
  "welcome": [
    { "id": "welcome.sit", "text": "Come. Sit with me.", "seconds": 3.2, "pause_after": 1.2, "fire": "welcoming" },
    { "id": "welcome.begin", "text": "This is a placeholder story for building the hearth. Touch Begin when you are ready.", "seconds": 5.5, "fire": "listening" }
  ],
  "beats": [
    {
      "id": "offer",
      "scene": "hearth",
      "lines": [
        { "id": "offer.light", "text": "Every story I tell begins with a little of my light.", "seconds": 4.0, "pause_after": 0.6, "fire": "telling" },
        {
          "id": "offer.hand",
          "text": "Hold out your open hand, palm up, and I will give you an ember to carry.",
          "seconds": 5.0,
          "fire": "holding",
          "actions": [{ "do": "offer", "object": "ember" }]
        }
      ],
      "invitation": {
        "id": "receive-ember",
        "kind": "receive",
        "object": "ember",
        "alternative": "Take the ember",
        "wait_seconds": 14,
        "accepted": [
          { "id": "offer.accepted", "text": "It is yours to carry now. Keep it close.", "seconds": 3.6, "pause_after": 0.8, "fire": "welcoming" }
        ],
        "default": [
          {
            "id": "offer.default",
            "text": "I will set it beside you, then. It will follow us.",
            "seconds": 4.0,
            "pause_after": 0.8,
            "fire": "holding",
            "actions": [{ "do": "place", "object": "ember" }]
          }
        ]
      }
    },
    {
      "id": "enter",
      "scene": "story.yard",
      "lines": [
        { "id": "enter.lantern", "text": "Look. The ember has become a lantern, and we are somewhere else.", "seconds": 4.8, "pause_after": 1.0, "fire": "gathering" },
        {
          "id": "enter.bowl",
          "text": "Someone left this bowl by the door, waiting for light.",
          "seconds": 4.2,
          "pause_after": 1.0,
          "fire": "telling",
          "actions": [{ "do": "reveal", "object": "bowl" }]
        }
      ]
    },
    {
      "id": "reveal",
      "scene": "story.yard",
      "lines": [
        {
          "id": "reveal.carried",
          "when": "receive-ember:accepted",
          "text": "Because you held out your hand, the lantern you carry lights the painted rim of the bowl.",
          "seconds": 5.8,
          "pause_after": 1.2,
          "fire": "telling",
          "actions": [{ "do": "illuminate", "object": "bowl" }]
        },
        {
          "id": "reveal.placed",
          "when": "receive-ember:default",
          "text": "The lantern I set beside you lights the painted rim of the bowl. Next time, you may carry it yourself.",
          "seconds": 6.4,
          "pause_after": 1.2,
          "fire": "telling",
          "actions": [{ "do": "illuminate", "object": "bowl" }]
        },
        { "id": "reveal.slot", "text": "The selected episode's real revelation will be told here.", "seconds": 4.0, "pause_after": 0.8, "fire": "holding" }
      ]
    },
    {
      "id": "return",
      "scene": "hearth",
      "lines": [
        { "id": "return.home", "text": "We are home again, and the ember is still with you.", "seconds": 4.0, "fire": "welcoming" }
      ]
    }
  ],
  "early_return": [
    { "id": "early.later", "text": "We can come back to this story whenever you like.", "seconds": 3.6, "fire": "welcoming" }
  ],
  "keepsake": "ember"
}
