          "when": "receive-bead:default",
          "audio": "enkare-nairobi.illustrated-v2/home.bead.beside"
        },
        {
          "id": "home.bead",
          "text": "Wambui arrived worried about what she owed. Naserian remembered what they had already given each other.",
          "seconds": 11.76,
          "pause_after": 1.5,
          "fire": "telling",
          "claims": [
            "R1"
          ],
          "audio": "enkare-nairobi.illustrated-v2/home.bead"
        },
        {
          "id": "home.next",
          "text": "Keep this visit if you want to return. The same water has another story, in the city that stands there now.",
          "seconds": 11.8,
          "pause_after": 0.6,
          "fire": "telling",
          "audio": "enkare-nairobi.illustrated-v2/home.next"
        }
