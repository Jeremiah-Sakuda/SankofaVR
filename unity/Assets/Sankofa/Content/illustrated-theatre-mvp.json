          "text": "The bead you received carries that meeting home with you.",
          "seconds": 6.88,
          "pause_after": 0.6,
          "fire": "telling",
          "claims": [
            "R1"
          ],
          "when": "receive-bead:accepted",
          "audio": "enkare-nairobi.illustrated-v2/home.bead.held"
        },
        {
          "id": "home.bead.beside",
          "text": "The bead Naserian left beside you has come back with the story.",
