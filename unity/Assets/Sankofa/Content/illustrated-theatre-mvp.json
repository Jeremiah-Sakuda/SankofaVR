        },
        {
          "id": "e1.problem",
          "text": "'And I walked here counting on it,' Naserian answers. For a moment, neither woman speaks.",
          "seconds": 11.0,
          "pause_after": 3.0,
          "fire": "holding",
          "claims": [
            "R1"
          ],
          "audio": "enkare-nairobi.illustrated-v2/e1.problem"
