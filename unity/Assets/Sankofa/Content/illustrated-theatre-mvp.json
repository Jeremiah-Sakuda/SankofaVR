      "scene": "story.water.1850s",
      "lines": [
        {
          "id": "e1.promise",
          "text": "'I did not want you waiting for me with no word,' Wambui says.",
          "seconds": 6.04,
          "pause_after": 1,
          "fire": "telling",
          "claims": [
            "R1"
          ],
          "audio": "enkare-nairobi.illustrated-v2/e1.promise"
        },
        {
          "id": "e1.remember",
          "text": "Naserian answers, 'Last time, you waited for me.'",
          "seconds": 6.8,
          "pause_after": 2.2,
          "fire": "telling",
          "claims": [
            "R1"
          ],
          "audio": "enkare-nairobi.illustrated-v2/e1.remember"
        },
        {
          "id": "e1.rest",
          "text": "'Take the sheep. Bring the rest when you can.'",
          "seconds": 5.08,
          "pause_after": 1,
          "fire": "telling",
          "claims": [
