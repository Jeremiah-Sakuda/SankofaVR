          "pause_after": 0.6,
          "fire": "telling",
          "claims": [
            "R1"
          ],
          "when": "offer-flour:accepted",
          "audio": "enkare-nairobi.illustrated-v2/home.trade.helped"
        },
        {
          "id": "home.trade.quiet",
          "text": "You were there while they worked it out. Their meeting had room for a quiet guest.",
          "seconds": 9.28,
          "pause_after": 0.6,
          "fire": "telling",
          "claims": [
            "R1"
          ],
          "when": "offer-flour:default",
          "audio": "enkare-nairobi.illustrated-v2/home.trade.quiet"
        },
        {
