      "questions": [
        {
          "id": "q.e1.friends",
          "label": "Are they friends?",
          "lines": [
            {
              "id": "q.e1.friends.answer",
              "text": "They have met here before. Each has had to wait for the other. That friendship is ours to imagine; trade and marriage really did join their communities.",
              "seconds": 15.84,
              "fire": "telling",
              "claims": [
                "R1",
                "C6"
              ],
              "audio": "enkare-nairobi.illustrated-v3/q.e1.friends.answer"
