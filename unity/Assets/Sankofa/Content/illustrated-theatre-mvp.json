      "questions": [
        {
          "id": "q.e1.trust",
          "label": "Why trust her?",
          "about": "figure.naserian",
          "lines": [
            {
              "id": "q.e1.trust.answer",
              "text": "Naserian remembers needing time herself. Wambui waited then. Now it is her turn. The sheep matters; so does seeing Wambui come back.",
              "seconds": 17.96,
              "pause_after": 0.6,
              "fire": "telling",
              "claims": [
                "R1"
              ],
              "audio": "enkare-nairobi.illustrated-v3/q.e1.trust.answer"
            }
          ]
        },
        {
          "id": "q.e1.cost",
          "label": "What does Wambui owe?",
          "about": "figure.wambui",
          "lines": [
            {
              "id": "q.e1.cost.answer",
              "text": "The flour she could not bring today, and another journey to meet Naserian. Neither woman has forgotten what her household needs. They have agreed to leave part of the exchange unfinished.",
              "seconds": 17.04,
              "pause_after": 0.6,
              "fire": "telling",
              "claims": [
                "R1"
              ],
              "audio": "enkare-nairobi.illustrated-v2/q.e1.cost.answer"
            }
          ]
        }
      ]
    },
