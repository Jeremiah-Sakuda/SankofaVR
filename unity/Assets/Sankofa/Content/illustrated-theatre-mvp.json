          "about": "figure.naserian"
        },
        {
          "id": "q.e1.milk",
          "label": "What is in the gourd?",
          "about": "gourd.milk",
          "lines": [
            {
              "id": "q.e1.milk.answer",
              "text": "Milk. A museum in Nairobi keeps a Maasai gourd smoked inside with oloirien wood. Imagine that trace of smoke in the vessel Naserian has brought.",
              "seconds": 18.16,
              "fire": "telling",
              "claims": [
                "C7",
                "R1"
              ],
              "audio": "enkare-nairobi.illustrated-v3/q.e1.milk.answer"
            }
          ]
        }
      ]
    },
