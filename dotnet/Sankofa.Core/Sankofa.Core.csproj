<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the engine-free story core that Unity compiles from unity/Assets/Sankofa/Core.
    netstandard2.1 and C# 9 match what Unity 6 accepts, so anything that builds here is usable in the player.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Sankofa.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/Assets/Sankofa/Core/**/*.cs" />
  </ItemGroup>
</Project>
