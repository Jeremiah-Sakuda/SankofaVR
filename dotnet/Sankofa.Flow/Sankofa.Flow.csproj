<Project Sdk="Microsoft.NET.Sdk">
  <!-- The application flow from unity/Assets/Sankofa/Flow. It depends on the story core, never the reverse. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Sankofa.Flow</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/Assets/Sankofa/Flow/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sankofa.Core/Sankofa.Core.csproj" />
  </ItemGroup>
</Project>
