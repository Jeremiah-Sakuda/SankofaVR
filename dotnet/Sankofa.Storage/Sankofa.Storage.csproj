<Project Sdk="Microsoft.NET.Sdk">
  <!-- File storage for kept visits from unity/Assets/Sankofa/Storage. The core stays free of file-system access. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Sankofa.Storage</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/Assets/Sankofa/Storage/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sankofa.Core/Sankofa.Core.csproj" />
  </ItemGroup>
</Project>
