<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine-free gesture logic from unity/Assets/Sankofa/Interaction, fed with joint positions by the XR adapter. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Sankofa.Interaction</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/Assets/Sankofa/Interaction/**/*.cs" />
  </ItemGroup>
</Project>
